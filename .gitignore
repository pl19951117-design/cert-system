# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# electron packaging
/release

# SQLite 数据库 —— 含真实个人信息（姓名 / 身份证号），绝不可上传！
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/prisma/template.db

# 本地数据库备份（同样含个人信息）
/backups/

# 附件上传目录（如有，含个人材料）
/uploads/
/attachments/

# Claude Code 本地设置
.claude/settings.local.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
